/* This library used to vendor a full copy of OpenFOAM's own fvOptions
   sources/constraints/corrections (stock, unmodified) purely to carry one
   change: variableHeatTransfer adapted to look up the strath multi2Thermo/
   compressible::turbulenceModel objects instead of the stock
   basicThermo/turbulenceModel. OpenFOAM v2412 ships the stock fvOptions
   library natively (-lfvOptions), so the port keeps only that one adapted
   class here, renamed to multi2VariableHeatTransfer to avoid clashing with
   the stock "variableHeatTransfer" runtime-selection entry. */

interRegion = sources/interRegion
$(interRegion)/interRegionHeatTransfer/variableHeatTransfer/multi2VariableHeatTransfer.C

LIB = $(FOAM_USER_LIBBIN)/libstrathFvOptions
